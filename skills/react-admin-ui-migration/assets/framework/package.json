{
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8000",
    "start": "vite --host 127.0.0.1 --port 8000",
    "dev:test": "vite --mode test --host 127.0.0.1 --port 8000",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build-test": "pnpm typecheck && vite build --mode test",
    "build-pre": "pnpm typecheck && vite build --mode pre",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . && stylelint \"src/**/*.less\" && node scripts/check-html-assets.mjs",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.less\" --fix"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@base-web-kits/base-tools-react": "1.4.8",
    "@base-web-kits/base-tools-ts": "1.5.2",
    "@base-web-kits/base-tools-web": "1.6.6",
    "@gancao-web/base-element-react": "3.0.0",
    "@gancao-web/request": "2.2.7",
    "@remix-run/router": "1.23.3",
    "antd": "4.24.16",
    "react": "18.3.1",
    "react-activation": "0.13.4",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.4",
    "rc-picker": "2.7.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@iconify-json/lucide": "1.2.123",
    "@types/crypto-js": "4.2.2",
    "@types/node": "20.19.43",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@unocss/preset-icons": "66.7.5",
    "@unocss/preset-wind3": "66.7.5",
    "@vitejs/plugin-legacy": "8.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.9.0",
    "less": "4.2.0",
    "postcss": "8.5.26",
    "postcss-html": "1.8.1",
    "postcss-less": "6.0.0",
    "prettier": "3.9.6",
    "stylelint": "17.14.1",
    "stylelint-config-recommended-less": "4.2.1",
    "stylelint-config-standard": "40.0.0",
    "stylelint-less": "4.2.1",
    "stylelint-order": "8.1.1",
    "stylelint-prettier": "5.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "unocss": "66.7.5",
    "vite": "8.2.1",
    "vite-plugin-svgr": "5.2.0",
    "terser": "5.49.2"
  }
